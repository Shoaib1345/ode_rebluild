.env
.env.*
!.env.example
*.key
*.pem
*.p12
auth.json

# ── Internal dev docs (not part of the shipped product) ───────────────────────
checkpoints/
PROJECT_MEMORY.md

# ── Local startup scripts (machine-specific paths / ports) ────────────────────
start-api.bat
start-frontend.bat
start-queue.bat

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

