##############################################################################
# One Day Event — Frontend Environment Template
# Copy to .env.production (or .env.local for dev) and fill in values.
# Never commit the real .env.production file to version control.
##############################################################################

# API base URL — no trailing slash
VITE_API_URL=https://api.onedayevent.com/api

VITE_APP_NAME=OneDayEvent

# Stripe publishable key (pk_live_ in production)
VITE_STRIPE_PK=pk_live_

# Google Places API key (used for venue address autocomplete, if enabled)
VITE_GOOGLE_PLACES_API_KEY=
