##############################################################################
# One Day Event — API Environment Template
# Copy to .env and fill in all values before deploying.
# Never commit the real .env file to version control.
##############################################################################

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=OneDayEvent
APP_ENV=production          # local | staging | production
APP_KEY=                    # Run: php artisan key:generate
APP_DEBUG=false             # MUST be false in production
APP_URL=https://api.onedayevent.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning           # Use 'error' or 'warning' in production (not 'debug')

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ode_rebuild
DB_USERNAME=
DB_PASSWORD=

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true        # MUST be true in production
SESSION_PATH=/
SESSION_DOMAIN=.onedayevent.com
SESSION_SECURE_COOKIE=true  # MUST be true when served over HTTPS

# ── Broadcasting / Filesystem / Queue ────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_STORE=database

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp            # Never use 'log' in production
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@onedayevent.com
MAIL_FROM_NAME=OneDayEvent

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_KEY=pk_live_
STRIPE_SECRET=sk_live_

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=https://www.onedayevent.com
# Comma-separated — no wildcards in production
CORS_ALLOWED_ORIGINS=https://www.onedayevent.com,https://onedayevent.com

# ── Sanctum ───────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=www.onedayevent.com,onedayevent.com
SANCTUM_TOKEN_EXPIRY=10080

# ── Legacy DB (remove after Chunk 29 migration is complete) ──────────────────
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=crm_new
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# ── Vite (frontend reference) ────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

##############################################################################
# PRODUCTION CHECKLIST
##############################################################################
# [ ] APP_DEBUG=false
# [ ] APP_ENV=production
# [ ] LOG_LEVEL=warning or error
# [ ] SESSION_ENCRYPT=true
# [ ] SESSION_SECURE_COOKIE=true
# [ ] CORS_ALLOWED_ORIGINS = exact production domain(s), no wildcards
# [ ] SANCTUM_STATEFUL_DOMAINS = exact production domain(s)
# [ ] STRIPE keys are live (pk_live_ / sk_live_)
# [ ] MAIL_MAILER is smtp/ses/mailgun — NOT 'log'
# [ ] FILESYSTEM_DISK=s3
# [ ] DB_PASSWORD is strong and unique
# [ ] Queue worker started via supervisord or equivalent
# [ ] php artisan config:cache && route:cache && view:cache
# [ ] Remove LEGACY_DB_* vars after migration
# [ ] .env is outside public/ and not web-accessible
##############################################################################
